rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the KIS editor account can change data. Email sign-up is open on
    // Firebase by default, so "signed in" alone isn't enough here.
    function isEditor() {
      return request.auth != null
        && request.auth.token.email in ['alain@gmail.com'];
    }

    // The dashboards are public read-only views for now.
    match /{document=**} {
      allow read: if true;
      allow write: if isEditor();
    }
  }
}
